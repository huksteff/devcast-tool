@@ -2454,6 +2454,11 @@ pub fn create_winit_window_attributes(
             && !fullscreen.unwrap_or(false)
             && _has_shadow.unwrap_or(true);
         window_attributes = window_attributes.with_undecorated_shadow(want_undecorated_shadow);
